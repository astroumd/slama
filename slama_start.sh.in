export  SLAMA=@SLAMA@

export PATH=$SLAMA/bin:$PATH
export SMAX_HOST=smax.sma.hawaii.edu
export SMAX_PORT=6379

# do python first. this is important if a venv is used  (new)
if [ -e $SLAMA/anaconda3/python_start.sh ]; then
    source $SLAMA/anaconda3/python_start.sh
fi

