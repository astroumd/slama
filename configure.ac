dnl Process this file with autoconf to produce a new configure script if it has changed. 
dnl ------------------------------------------------------------------------------------

AC_INIT
AC_CONFIG_SRCDIR([README.md])

AC_MSG_CHECKING([SLAMA config])
echo ""

SLAMA="`pwd`"
AC_SUBST(SLAMA)
echo Using SLAMA=$SLAMA

EDIT_MSG="Do not edit this file, it has been generated via configure in SLAMA"
AC_SUBST(EDIT_MSG)

# create and set global environment variables like REDIS_NAME, REDIS_CLI, RESID_SERVER, REDIS_PORT, LUA 
#    - maybe add $REDIS_DBFILE to the list (sma-shared-variables.rdb)

# update data/valkey_sma.conf to use $REDIS_PORT, REDIS_DBFILE


REDIS_NAME="Valkey"
AC_SUBST(REDIS_NAME)

REDIS_CLI="valkey-cli_sma"
AC_SUBST(REDIS_CLI)

REDIS_SERVER="valkey-server_sma"
AC_SUBST(REDIS_SERVER)

port_default=6380
AC_ARG_WITH(port,
        [  --with-port=PORT        port number for redix (default: 6380)],
	port_val="$withval",
	port_val="$port_default")
REDIS_PORT=$port_val
AC_SUBST(REDIS_PORT)
AC_MSG_RESULT(Using REDIS_PORT=$REDIS_PORT)

#        AC_HELP_STRING([  --with-port=PORT        port number for redix ($port_val)]),

db_default=sma-shared-variables.rdb
AC_ARG_WITH(db,
	[  --with-db=DBFILE        valkey (old redis) database filename  (default: sma-shared-variables.rdb)],
	db_val="$withval",
	db_val="$db_default")
REDIS_DBFILE=$db_val
AC_SUBST(REDIS_DBFILE)
AC_MSG_RESULT(Using REDIS_DBFILE=$REDIS_DBFILE)


# lua
LUA=$SLAMA/lua
AC_SUBST(LUA)


AC_CONFIG_FILES([slama_start.sh data/valkey_sma.conf smax-init.sh valkey-init.sh])
AC_OUTPUT

echo "
-------------------------------------------------------------------------
All done configuring, continue with your installation with....
-------------------------------------------------------------------------
"
