{
  "_note": [
    "See docs/monitorsystem_writer_design.md for the full design.",
    "Each entry writes 'output' (declared under the 'monitorsystem' subtree",
    "in smax.json) by applying 'function' (registered in",
    "slama.monitor.compute.functions) to 'inputs'.",
    "Inputs written as {\"name\": ..., \"staleness_s\": null} are exempt from",
    "the SMAX-timestamp staleness check: either an RM heartbeat whose *value*",
    "is a Unix time (the function checks its age), or a status point the",
    "RM/DSM bridge writes only when its value changes."
  ],
  "defaults": {
    "interval_s": 2,
    "staleness_s": 30,
    "invalid_inputs": "skip"
  },
  "computations": [
    {
      "output": "monitorsystem:array:antennas_online",
      "function": "count_true",
      "inputs": ["DSM:hal9000:DSM_ONLINE_ANTENNAS_V11_B"],
      "params": {
        "_comment": "V11 vector: index 0 is a placeholder, 1-8 are the standard antennas; 9/10 (JCMT/CSO) are omitted unless patched into the array. staleness_s null: DSM writes this only when array membership changes (19 h old in the 2026-09-22 snapshot), so its SMAX timestamp is not a freshness signal.",
        "indices": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "staleness_s": null
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:sun_distance",
          "function": "sun_distance",
          "inputs": {
            "sunaz": "RM:acc{i}:RM_SUN_AZ_DEG_F",
            "sunel": "RM:acc{i}:RM_SUN_EL_DEG_F",
            "antaz": "RM:acc{i}:RM_ACTUAL_AZ_DEG_F",
            "antel": "RM:acc{i}:RM_ACTUAL_EL_DEG_F",
            "track_ts": {"name": "RM:acc{i}:RM_TRACK_TIMESTAMP_L", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:track_age",
          "function": "timestamp_age",
          "inputs": {"ts": {"name": "RM:acc{i}:RM_TRACK_TIMESTAMP_L", "staleness_s": null}}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:servo_age",
          "function": "timestamp_age",
          "inputs": {"ts": {"name": "RM:acc{i}:RM_SERVO_TIMESTAMP_L", "staleness_s": null}}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:on_source",
          "function": "on_source",
          "inputs": {
            "tracking_error": "RM:acc{i}:RM_TRACKING_ERROR_ARCSEC_F",
            "refraction_flag": {"name": "RM:acc{i}:RM_REFRACTION_RADIO_FLAG_B", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:drive_status",
          "function": "drive_status",
          "inputs": {
            "drive": {"name": "RM:acc{i}:RM_ANTENNA_DRIVE_STATUS_B", "staleness_s": null},
            "fault_state": {"name": "RM:acc{i}:RM_SERVO_FAULT_STATE_B", "staleness_s": null},
            "faultword": {"name": "RM:acc{i}:RM_SCB_FAULTWORD_L", "staleness_s": null},
            "servo_ts": {"name": "RM:acc{i}:RM_SERVO_TIMESTAMP_L", "staleness_s": null},
            "tracking_error": "RM:acc{i}:RM_TRACKING_ERROR_ARCSEC_F",
            "enc_az": "RM:acc{i}:RM_ENCODER_AZ_F",
            "enc_el": "RM:acc{i}:RM_ENCODER_EL_F",
            "up_limit": {"name": "RM:acc{i}:RM_SCB_UP_LIMIT_F", "staleness_s": null},
            "low_limit": {"name": "RM:acc{i}:RM_SCB_LOW_LIMIT_F", "staleness_s": null},
            "cw_limit": {"name": "RM:acc{i}:RM_SCB_CW_LIMIT_F", "staleness_s": null},
            "ccw_limit": {"name": "RM:acc{i}:RM_SCB_CCW_LIMIT_F", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": {
            "status": "monitorsystem:antenna:{i}:chopper_status",
            "focus_curve": "monitorsystem:antenna:{i}:focus_curve"
          },
          "function": "chopper_status",
          "inputs": {
            "bits": {"name": "RM:acc{i}:RM_CHOPPER_STATUS_BITS_V16_B", "staleness_s": null},
            "ts": {"name": "RM:acc{i}:RM_CHOPPER_MONITOR_TIMESTAMP_L", "staleness_s": null}
          }
        }
      }
    },
    {
      "output": "monitorsystem:array:focus_curve_count",
      "function": "count_true",
      "inputs": ["monitorsystem:antenna:1-8:focus_curve"],
      "invalid_inputs": "skip"
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:deice_status",
          "function": "deice_status",
          "inputs": {
            "ts": {"name": "RM:acc{i}:RM_DEICE_TIMESTAMP_L", "staleness_s": null},
            "bits": {"name": "RM:acc{i}:RM_DEICE_STATUS_BITS_L", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:clock_offset_s",
          "function": "clock_offset",
          "inputs": {"utc_hr": "RM:acc{i}:RM_UTC_HR_D"}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:yig1_locked",
          "function": "yig_locked",
          "inputs": {"locked": {"name": "RM:acc{i}:RM_YIG1_LOCKED_S", "staleness_s": null}}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:yig2_locked",
          "function": "yig_locked",
          "inputs": {"locked": {"name": "RM:acc{i}:RM_YIG2_LOCKED_S", "staleness_s": null}}
        }
      }
    },
    {
      "__each__": {
        "over": "2-6", "as": "i",
        "template": {
          "_comment": "Tune6 receivers only (antennas 2-6 per rxtype.conf, 2026-09-22); wSMA LO lock (1, 7, 8) not yet ported.",
          "output": "monitorsystem:antenna:{i}:lo_status",
          "function": "lo_status",
          "inputs": {
            "busy": {"name": "RM:acc{i}:RM_TUNE6_COMMAND_BUSY_S", "staleness_s": null},
            "gunn1": {"name": "RM:acc{i}:RM_GUNN1_LOCKED_S", "staleness_s": null},
            "gunn2": {"name": "RM:acc{i}:RM_GUNN2_LOCKED_S", "staleness_s": null},
            "yig1": {"name": "RM:acc{i}:RM_YIG1_LOCKED_S", "staleness_s": null},
            "yig2": {"name": "RM:acc{i}:RM_YIG2_LOCKED_S", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "2-6", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:lo_lock_ok",
          "function": "lo_lock_ok",
          "inputs": {
            "gunn1": {"name": "RM:acc{i}:RM_GUNN1_LOCKED_S", "staleness_s": null},
            "gunn2": {"name": "RM:acc{i}:RM_GUNN2_LOCKED_S", "staleness_s": null},
            "yig1": {"name": "RM:acc{i}:RM_YIG1_LOCKED_S", "staleness_s": null},
            "gunn1_ts": {"name": "RM:acc{i}:RM_GUNN1_LOCKED_TIMESTAMP_L", "staleness_s": null},
            "rest_freq": {"name": "DSM:hal9000:DSM_REQUESTED_FREQUENCY_V2_D", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "2-6", "as": "i",
        "template": {
          "_comment": "Tune6 antennas check the optics board first (arrayMonitor.c 2338-2341).",
          "output": "monitorsystem:antenna:{i}:hotload_position",
          "function": "hotload_position",
          "inputs": {
            "status": {"name": "RM:acc{i}:RM_UNHEATEDLOAD_STATUS_S", "staleness_s": null},
            "busy": {"name": "RM:acc{i}:RM_TUNE6_COMMAND_BUSY_S", "staleness_s": null},
            "optics_board": {"name": "RM:acc{i}:RM_OPTICS_BOARD_PRESENT_S", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1,7,8", "as": "i",
        "template": {
          "_comment": "wSMA-load antennas: no optics-board check (arrayMonitor.c 2335-2336).",
          "output": "monitorsystem:antenna:{i}:hotload_position",
          "function": "hotload_position",
          "inputs": {
            "status": {"name": "RM:acc{i}:RM_UNHEATEDLOAD_STATUS_S", "staleness_s": null},
            "busy": {"name": "RM:acc{i}:RM_TUNE6_COMMAND_BUSY_S", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:rx_low_label",
          "function": "rx_label",
          "inputs": {"code": {"name": "RM:acc{i}:RM_ACTIVE_LOW_RECEIVER_C10", "staleness_s": null}},
          "params": {"default": "A"}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:rx_high_label",
          "function": "rx_label",
          "inputs": {"code": {"name": "RM:acc{i}:RM_ACTIVE_HIGH_RECEIVER_C10", "staleness_s": null}},
          "params": {"default": "B"}
        }
      }
    },
    {
      "_comment": "Receiver slot 1 = low (vector index 0), 2 = high (index 1).",
      "output": "monitorsystem:rx:1:line_name",
      "function": "line_name",
      "inputs": {
        "names": {"name": "DSM:hal9000:DSM_AS_IFLO_LINE_NAME_V2_C41", "staleness_s": null},
        "chunks": {"name": "DSM:hal9000:DSM_REQUESTED_CHUNK_V2_S", "staleness_s": null},
        "mrg_locked": {"name": "DSM:m5:MRG_CONTROL_X:YIG_LOCKED_V2_S", "staleness_s": null}
      },
      "params": {"index": 0}
    },
    {
      "output": "monitorsystem:rx:2:line_name",
      "function": "line_name",
      "inputs": {
        "names": {"name": "DSM:hal9000:DSM_AS_IFLO_LINE_NAME_V2_C41", "staleness_s": null},
        "chunks": {"name": "DSM:hal9000:DSM_REQUESTED_CHUNK_V2_S", "staleness_s": null},
        "mrg_locked": {"name": "DSM:m5:MRG_CONTROL_X:YIG_LOCKED_V2_S", "staleness_s": null}
      },
      "params": {"index": 1}
    },
    {
      "_comment": "Tune6 dewars. sensor = dewarTemp.conf ch4 - 1 (cursesmonitor/cfg/dewarTemp.conf): ant2 ch9, ant4 ch3, ants 3/5/6 ch11.",
      "output": "monitorsystem:antenna:2:dewar_4k_temp",
      "function": "dewar_4k_temp",
      "inputs": {
        "temps": {"name": "RM:acc2:RM_DEWAR_TEMPS_V16_F", "staleness_s": null},
        "ts": {"name": "RM:acc2:RM_LAKESHORE_TIMESTAMP_L", "staleness_s": null}
      },
      "params": {"sensor": 8}
    },
    {
      "output": "monitorsystem:antenna:4:dewar_4k_temp",
      "function": "dewar_4k_temp",
      "inputs": {
        "temps": {"name": "RM:acc4:RM_DEWAR_TEMPS_V16_F", "staleness_s": null},
        "ts": {"name": "RM:acc4:RM_LAKESHORE_TIMESTAMP_L", "staleness_s": null}
      },
      "params": {"sensor": 2}
    },
    {
      "__each__": {
        "over": "3,5,6", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:dewar_4k_temp",
          "function": "dewar_4k_temp",
          "inputs": {
            "temps": {"name": "RM:acc{i}:RM_DEWAR_TEMPS_V16_F", "staleness_s": null},
            "ts": {"name": "RM:acc{i}:RM_LAKESHORE_TIMESTAMP_L", "staleness_s": null}
          },
          "params": {"sensor": 10}
        }
      }
    },
    {
      "__each__": {
        "over": "1,7,8", "as": "i",
        "template": {
          "_comment": "wSMA dewars: SMAX-native 4K plate; 60 s = arrayMonitor.c LAKESHORE_STALE applied to its SMAX timestamp.",
          "output": "monitorsystem:antenna:{i}:dewar_4k_temp",
          "function": "dewar_4k_temp",
          "inputs": {
            "temp": {"name": "antenna:{i}:receiver:wsma:cryostat:temperatures:4K-plate", "staleness_s": 60}
          }
        }
      }
    },
    {
      "_comment": "DSM:colossus weather. Stations can stop being written entirely (CFHT since March 2026; UKIRT is decommissioned and not an input), so wind/data_age use staleness_s null and check each struct's SERVER_TIMESTAMP_L value instead.",
      "output": {
        "speed": "monitorsystem:weather:wind_speed",
        "direction": "monitorsystem:weather:wind_direction",
        "source": "monitorsystem:weather:wind_source",
        "invalid_stations": "monitorsystem:weather:wind_invalid_stations"
      },
      "function": "wind",
      "inputs": {
        "server": "DSM:colossus:DSM_WIND_SERVER_C7",
        "SMA_speed": "DSM:colossus:SMA_METEOROLOGY_X:WINDSPEED_F",
        "SMA_dir": "DSM:colossus:SMA_METEOROLOGY_X:WINDDIR_F",
        "SMA_ts": "DSM:colossus:SMA_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "CFHT_speed": "DSM:colossus:CFHT_METEOROLOGY_X:WINDSPEED_F",
        "CFHT_dir": "DSM:colossus:CFHT_METEOROLOGY_X:WINDDIR_F",
        "CFHT_ts": "DSM:colossus:CFHT_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "SUBARU_speed": "DSM:colossus:SUBARU_METEOROLOGY_X:WINDSPEED_F",
        "SUBARU_dir": "DSM:colossus:SUBARU_METEOROLOGY_X:WINDDIR_F",
        "SUBARU_ts": "DSM:colossus:SUBARU_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "UH88_speed": "DSM:colossus:UH88_METEOROLOGY_X:WINDSPEED_F",
        "UH88_dir": "DSM:colossus:UH88_METEOROLOGY_X:WINDDIR_F",
        "UH88_ts": "DSM:colossus:UH88_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "VLBA_speed": "DSM:colossus:VLBA_METEOROLOGY_X:WINDSPEED_F",
        "VLBA_dir": "DSM:colossus:VLBA_METEOROLOGY_X:WINDDIR_F",
        "VLBA_ts": "DSM:colossus:VLBA_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "IRTF_speed": "DSM:colossus:IRTF_METEOROLOGY_X:WINDSPEED_F",
        "IRTF_dir": "DSM:colossus:IRTF_METEOROLOGY_X:WINDDIR_F",
        "IRTF_ts": "DSM:colossus:IRTF_METEOROLOGY_X:SERVER_TIMESTAMP_L"
      },
      "staleness_s": null
    },
    {
      "output": "monitorsystem:weather:sun_visible",
      "function": "sun_visible",
      "inputs": {
        "solar_temp": "DSM:colossus:SMA_METEOROLOGY_X:SOLAR_TEMP_F",
        "air_temp": "DSM:colossus:SMA_METEOROLOGY_X:TEMP_F"
      },
      "staleness_s": 90
    },
    {
      "output": "monitorsystem:weather:server_label",
      "function": "weather_server_label",
      "inputs": {
        "temperature": "DSM:colossus:DSM_TEMPERATURE_SERVER_C7",
        "humidity": "DSM:colossus:DSM_HUMIDITY_SERVER_C7",
        "wind": "DSM:colossus:DSM_WIND_SERVER_C7",
        "pressure": "DSM:colossus:DSM_PRESSURE_SERVER_C7"
      },
      "staleness_s": 90
    },
    {
      "output": "monitorsystem:weather:data_age_s",
      "function": "weather_data_age",
      "inputs": {
        "server": "DSM:colossus:DSM_TEMPERATURE_SERVER_C7",
        "manual": "DSM:colossus:DSM_MANUAL_WEATHER_FLAG_S",
        "getweather_ts": "DSM:colossus:DSM_GETWEATHER_TIMESTAMP_L",
        "SMA_ts": "DSM:colossus:SMA_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "KECK_ts": "DSM:colossus:KECK_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "CFHT_ts": "DSM:colossus:CFHT_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "SUBARU_ts": "DSM:colossus:SUBARU_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "JCMT_ts": "DSM:colossus:JCMT_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "UH88_ts": "DSM:colossus:UH88_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "VLBA_ts": "DSM:colossus:VLBA_METEOROLOGY_X:SERVER_TIMESTAMP_L",
        "IRTF_ts": "DSM:colossus:IRTF_METEOROLOGY_X:SERVER_TIMESTAMP_L"
      },
      "staleness_s": null
    },
    {
      "output": "monitorsystem:array:genset_active",
      "function": "genset_active",
      "inputs": {
        "l1": "DSM:obscon:DSM_IWATCH_DATA_X:CURRENTL1_F",
        "l2": "DSM:obscon:DSM_IWATCH_DATA_X:CURRENTL2_F",
        "l3": "DSM:obscon:DSM_IWATCH_DATA_X:CURRENTL3_F"
      },
      "staleness_s": 90
    },
    {
      "_comment": "TSTAMP is minutes of the UT day; compared against wall-clock UT in the function.",
      "output": "monitorsystem:weather:tau225_stale",
      "function": "tau_stale",
      "inputs": {
        "tstamp": "DSM:colossus:DSM_CSO_225GHZ_TAU_TSTAMP_L"
      },
      "params": {
        "margin_h": 1.0
      },
      "staleness_s": 90
    },
    {
      "output": "monitorsystem:weather:tau350_stale",
      "function": "tau_stale",
      "inputs": {
        "tstamp": "DSM:colossus:DSM_CSO_350MICRON_TAU_TSTAMP_L"
      },
      "params": {
        "margin_h": 0.5
      },
      "staleness_s": 90
    },
    {
      "output": "monitorsystem:weather:gfs_tau225",
      "function": "tau_standout",
      "inputs": {
        "tau": {
          "name": "weather:forecast:gfs:tau225",
          "staleness_s": 1800
        },
        "rest_freq": {
          "name": "DSM:hal9000:DSM_REQUESTED_FREQUENCY_V2_D",
          "staleness_s": null
        }
      }
    }
  ]
}
