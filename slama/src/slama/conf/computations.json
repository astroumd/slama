            "bits": {"name": "RM:acc{i}:RM_DEICE_STATUS_BITS_L", "staleness_s": null}
          }
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:clock_offset_s",
          "function": "clock_offset",
          "inputs": {"utc_hr": "RM:acc{i}:RM_UTC_HR_D"}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:yig1_locked",
          "function": "yig_locked",
          "inputs": {"locked": {"name": "RM:acc{i}:RM_YIG1_LOCKED_S", "staleness_s": null}}
        }
      }
    },
    {
      "__each__": {
        "over": "1-8", "as": "i",
        "template": {
          "output": "monitorsystem:antenna:{i}:yig2_locked",
          "function": "yig_locked",
          "inputs": {"locked": {"name": "RM:acc{i}:RM_YIG2_LOCKED_S", "staleness_s": null}}
        }
      }
    },
    {
      "__each__": {
        "over": "@rxtype:!wsma", "as": "i",
        "template": {
          "_comment": "Non-wSMA receivers (rxtype.conf; the C's else branch, arrayMonitor.c 491-505). wSMA LO lock not yet ported.",
          "output": "monitorsystem:antenna:{i}:lo_status",
          "function": "lo_status",
          "inputs": {
            "busy": {"name": "RM:acc{i}:RM_TUNE6_COMMAND_BUSY_S", "staleness_s": null},
            "gunn1": {"name": "RM:acc{i}:RM_GUNN1_LOCKED_S", "staleness_s": null},
            "gunn2": {"name": "RM:acc{i}:RM_GUNN2_LOCKED_S", "staleness_s": null},
            "yig1": {"name": "RM:acc{i}:RM_YIG1_LOCKED_S", "staleness_s": null},
            "yig2": {"name": "RM:acc{i}:RM_YIG2_LOCKED_S", "staleness_s": null}
          }
        }
