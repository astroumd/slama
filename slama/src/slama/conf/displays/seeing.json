{
  "name": "Seeing (Phase Monitor)",
  "description": "12 GHz phase monitor: baseline phases, RMS, optical links, vault voltages — DSM placeholders",
  "update_interval": 10,
  "layout": [
    {
      "type": "table",
      "title": "Pad Assignment (RM — live)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Pad ID", "points": "RM:acc{ant}:RM_PAD_ID_B", "display_min": 1, "display_max": 30}
      ]
    },
    {
      "type": "cells",
      "title": "Phase Monitor Baselines (DSM — placeholders)",
      "cells": [
        {"label": "Baseline 1 Raw Phase (deg) (DSM)",  "point": "DSM:phasemon:PHASEMON_DATA_X:RAW_PHASE_V10_D"},
        {"label": "Baseline 2 Raw Phase (deg) (DSM)",  "point": "DSM:phasemon:PHASEMON_DATA_X:RAW_PHASE_V10_D"},
        {"label": "Baseline 3 Raw Phase (deg) (DSM)",  "point": "DSM:phasemon:PHASEMON_DATA_X:RAW_PHASE_V10_D"},
        {"label": "Baseline 4 Raw Phase (deg) (DSM)",  "point": "DSM:phasemon:PHASEMON_DATA_X:RAW_PHASE_V10_D"},
        {"label": "Baseline 1 Atmos (deg) (DSM)",      "point": "DSM:phasemon:PHASEMON_DATA_X:ATMOSPHERIC_PHASE_V10_D"},
        {"label": "Baseline 2 Atmos (deg) (DSM)",      "point": "DSM:phasemon:PHASEMON_DATA_X:ATMOSPHERIC_PHASE_V10_D"},
        {"label": "Baseline 1 RMS 1s (deg) (DSM)",     "point": "DSM:phasemon:PHASEMON_DATA_X:RMS_PHASE_V10_V12_D"},
        {"label": "Baseline 1 RMS 16s (deg) (DSM)",    "point": "DSM:phasemon:PHASEMON_DATA_X:RMS_PHASE_V10_V12_D"},
        {"label": "Baseline 1 RMS 512s (deg) (DSM)",   "point": "DSM:phasemon:PHASEMON_DATA_X:RMS_PHASE_V10_V12_D"}
      ]
    },
    {
      "type": "cells",
      "title": "Vault Voltages (DSM — placeholders)",
      "cells": [
        {"label": "+5V (DSM)",    "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:POS_5V_RACK_F"},
        {"label": "+12V (DSM)",   "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:POS_12V_RACK_F"},
        {"label": "+25V (DSM)",   "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:POS_25V_RACK_F"},
        {"label": "-15V (DSM)",   "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:NEG_15V_RACK_F"},
        {"label": "+15Va (DSM)",  "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:POS_15VA_RACK_F"},
        {"label": "+15Vb (DSM)",  "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:POS_15VB_RACK_F"},
        {"label": "SynthLock (DSM)", "point": "DSM:phasemon:PHASEMON_HRDWR_STAT_X:SYNTH_LOCK_B"}
      ]
    }
  ]
}
