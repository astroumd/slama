{
  "name": "Air Handler (Blower)",
  "description": "Antenna air handler dampers, temperatures, and heater status (from airHandler.c)",
  "update_interval": 10,
  "layout": [
    {
      "type": "table",
      "title": "Air Handler",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Inside air damper",   "points": "RM:acc{ant}:RM_AIR_HANDLER_INSIDE_AIR_DAMPER_F",  "format": "{:.3f}", "display_min": -20, "display_max": 100},
        {"label": "Outside air damper",  "points": "RM:acc{ant}:RM_AIR_HANDLER_OUTSIDE_AIR_DAMPER_F", "format": "{:.3f}", "display_min": -20, "display_max": 100},
        {"label": "Servo output (V)",    "points": "RM:acc{ant}:RM_AIR_HANDLER_SERVO_CMD_TO_DAMPERS_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Intake Air temp (C)",     "points": "RM:acc{ant}:RM_AIR_HANDLER_INTAKE_TEMPERATURE_F", "format": "{:.2f}", "display_min": -20, "display_max": 200},
        {"label": "Heater enabled",      "points": "RM:acc{ant}:RM_AIR_HANDLER_HEATER_ENABLED_S"},
        {"label": "Heater delta-T", "points": "RM:acc{ant}:RM_AIR_HANDLER_HEATER_DELTA_T_SEEN_S"},
        {"label": "Pre-heater temp (C)", "points": "RM:acc{ant}:RM_AIR_HANDLER_PRE_HEATER_TEMPERATURE_F", "format": "{:.2f}", "display_min": -20, "display_max": 200},
        {"label": "Post-heater temp (C)", "points": "RM:acc{ant}:RM_AIR_HANDLER_SOCK_TEMPERATURE_F", "format": "{:.2f}", "display_min": -20, "display_max": 200},
        {"label": "Thermostat set point (C)",       "points": "RM:acc{ant}:RM_AIR_HANDLER_SET_POINT_F", "format": "{:.2f}", "display_min": -50, "display_max": 200},
        {"label": "Thermostat Feedback (C)","points": "RM:acc{ant}:RM_AIR_HANDLER_SERVO_CABIN_TEMP_F", "format": "{:.2f}", "display_min": -10, "display_max": 200},
        {"label": "UPS Ambient temp (C)",       "points": "DSM:acc{ant}:UPS_DATA_X:AMBIENT_TEMPERATURE_F", "format": "{:.1f}", "display_min": -20, "display_max": 300},
        {"label": "Rack temp (C)",       "points": "RM:acc{ant}:RM_AIR_HANDLER_RACK_TEMPERATURE_F", "format": "{:.1f}", "display_min": -50, "display_max": 200},
        {"label": "Enclosure temp (C)",  "points": "RM:acc{ant}:RM_AIR_HANDLER_ENCLOSURE_TEMPERATURE_F", "format": "{:.2f}", "display_min": -20, "display_max": 200},
        {"label": "Differential Pressure",      "points": "RM:acc{ant}:RM_AIR_HANDLER_DIFFERENTIAL_PRESSURE_F", "format": "{:.3f}", "display_min": -100, "display_max": 100},
        {"label": "Relative humidity (%)",   "points": "RM:acc{ant}:RM_AIR_HANDLER_SOCK_HUMIDITY_F", "format": "{:.1f}", "display_min": 0, "display_max": 100}
      ]
    },
    {
      "type": "table",
      "title": "Site Weather",
      "columns": {
        "labels": ["SMA", "JCMT", "Subaru", "UKIRT", "CFHT", "UH88", "Keck", "VLBA"],
        "var": "site",
        "values": ["SMA", "JCMT", "SUBARU", "UKIRT", "CFHT", "UH88", "KECK", "VLBA"]
      },
      "rows": [
        {"label": "Temperature (C)",     "points": "DSM:colossus:{site}_METEOROLOGY_X:TEMP_F", "format": "{:.2f}" },
        {"label": "Rel. Humidity (%)",       "points": "DSM:colossus:{site}_METEOROLOGY_X:HUMIDITY_F", "format": "{:.1f}" }
      ]
    }
  ]
}
