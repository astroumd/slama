{
  "name": "AC/PACU Monitor",
  "description": "Correlator AC unit: temperature, smoke detectors, fans, compressors — DSM placeholders",
  "update_interval": 30,
  "layout": [
    {
      "type": "cells",
      "title": "AC/PACU Status (DSM — placeholders)",
      "cells": [
        {"label": "Temp (C) (DSM)",          "point": "DSM:corcon:CORR_PACU_STATUS_X:RETURN_AIR_TEMP_F"},
        {"label": "Smoke detected (DSM)",    "point": "DSM:corcon:CORR_PACU_STATUS_X:RETURN_DUCT_SMOKE_B"},
        {"label": "Fan status (DSM)",        "point": "DSM:corcon:CORR_PACU_STATUS_X:RETURN_FAN_STARTED_B"},
        {"label": "Compressor 1 (DSM)",      "point": "DSM:corcon:CORR_PACU_STATUS_X:COMPRESSOR_1_STAGE_A_B"},
        {"label": "Compressor 2 (DSM)",      "point": "DSM:corcon:CORR_PACU_STATUS_X:COMPRESSOR_2_STAGE_A_B"},
        {"label": "Humidity % (DSM)",        "point": "DSM:corcon:CORR_PACU_STATUS_X:RETURN_AIR_REL_HUM_F"},
        {"label": "PACU status (DSM)",       "point": "dsm:placeholder:DSM_PACU_STATUS"}
      ]
    }
  ]
}
