{
  "name": "UPS Power",
  "description": "Uninterruptible power supply: AC/battery voltage, current, load, temperature — DSM placeholders",
  "update_interval": 30,
  "layout": [
    {
      "type": "table",
      "title": "UPS AC Input / Output (DSM — placeholders)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "AC Input (V) (DSM)",    "points": "DSM:acc{ant}:UPS_DATA_X:AC_VOLTAGE_IN_F"},
        {"label": "Frequency (Hz) (DSM)",  "points": "DSM:acc{ant}:UPS_DATA_X:AC_FREQUENCY_IN_F"},
        {"label": "AC Output (V) (DSM)",   "points": "DSM:acc{ant}:UPS_DATA_X:AC_VOLTAGE_OUT_F"},
        {"label": "Current (A) (DSM)",     "points": "DSM:acc{ant}:UPS_DATA_X:AC_CURRENT_OUT_F"},
        {"label": "Power (W) (DSM)",       "points": "DSM:acc{ant}:UPS_DATA_X:AC_WATTS_IN_F"},
        {"label": "App Power (VA) (DSM)",  "points": "DSM:acc{ant}:UPS_DATA_X:AC_VA_OUT_F"}
      ]
    },
    {
      "type": "table",
      "title": "UPS Battery and Thermal (DSM — placeholders)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Battery (V) (DSM)",     "points": "DSM:acc{ant}:UPS_DATA_X:BATTERY_VOLTAGE_F"},
        {"label": "Batt I (A) (DSM)",      "points": "DSM:acc{ant}:UPS_DATA_X:BATTERY_CURRENT_F"},
        {"label": "Load % (DSM)",          "points": "DSM:acc{ant}:UPS_DATA_X:LOAD_PERCENTAGE_F"},
        {"label": "Run time (min) (DSM)",  "points": "DSM:acc{ant}:UPS_DATA_X:RUN_TIME_AVAILABLE_F"},
        {"label": "Ambient (C) (DSM)",     "points": "DSM:acc{ant}:UPS_DATA_X:AMBIENT_TEMPERATURE_F"},
        {"label": "HeatSink (C) (DSM)",    "points": "DSM:acc{ant}:UPS_DATA_X:HEAT_SINK_TEMPERATURE_F"},
        {"label": "OverLoads (DSM)",       "points": "DSM:acc{ant}:UPS_DATA_X:NUMBER_OF_OVERLOADS_S"},
        {"label": "Power outs (DSM)",      "points": "DSM:acc{ant}:UPS_DATA_X:NUMBER_OF_POWER_OUTAGES_S"},
        {"label": "Active alarms (DSM)",   "points": "DSM:acc{ant}:UPS_DATA_X:ACTIVE_ALARMS_L"}
      ]
    }
  ]
}
