{
  "name": "C. Room IF/LO Parameters",
  "description": "iFLO integrated F-Engine LO lock status and IF power — DSM placeholders",
  "update_interval": 5,
  "layout": [
      {
          "type":"cells",
          "title":"Tracking Parameters",
          "cells": [
              {"label":"Doppler Track Parameters" , "point":"DSM:hal9000:DSM_LST_DOPPLERTRACK_C100"},
              {"label":"Issued at" , "point":"DSM:hal9000:DSM_AS_IFLO_REST_FR_V2_D", "element_index":[0]},
              {"label":"Rest Freq" , "point":"DSM:hal9000:DSM_AS_IFLO_REST_FR_V2_D", "element_index":[1], "format":"{:.4f}", "display_min":0, "display_max":1000},
              {"label":"Tracking" , "point":"DSM:hal9000:DSM_AS_IFLO_SOUR_C34"},
              {"label":"RA" , "point":"DSM:hal9000:DSM_AS_IFLO_RA_D"},
              {"label":"DEC" , "point":"DSM:hal9000:DSM_AS_IFLO_DEC_D"},
              {"label":"Vel (m/s)" , "point":"DSM:hal9000:DSM_AS_IFLO_VELO_D", "display_min":-300000000, "display_max":300000000}
          ]
      },
    {
      "type": "table",
      "title": "iFLO LO Lock and IF Power (DSM — placeholders)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "LO lock status (DSM)",  "points": "dsm:placeholder:DSM_ANT{ant}_IFLO_LO_LOCK"},
        {"label": "IF power (DSM)",        "points": "dsm:placeholder:DSM_ANT{ant}_IFLO_IF_POWER"},
        {"label": "LO freq (GHz) (DSM)",   "points": "dsm:placeholder:DSM_ANT{ant}_IFLO_LO_FREQ"},
        {"label": "Last update (DSM)",     "points": "dsm:placeholder:DSM_ANT{ant}_IFLO_TIMESTAMP"}
      ]
    }
  ]
}
