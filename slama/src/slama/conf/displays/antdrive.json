{
  "name": "Antenna Drive",
  "description": "Antenna servo/drive status: glycol, IRIG timing, SCB, bypass flags (from antPage2.c)",
  "update_interval": 5,
  "layout": [
    {
      "type": "table",
      "title": "Glycol Cooling System",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Glycol Flow (gpm)", "points": "RM:acc{ant}:RM_GLYCOL_FLOW_D",     "format": "{:.2f}", "display_min": 0,  "display_max": 100},
        {"label": "Glycol Temp (C)",   "points": "RM:acc{ant}:RM_GLYCOL_TEMP_D",     "format": "{:.1f}", "display_min": -50, "display_max": 150},
        {"label": "Glycol Pres (psi)", "points": "RM:acc{ant}:RM_GLYCOL_PRESSURE_D", "format": "{:.1f}", "display_min": 0,  "display_max": 200}
      ]
    },
    {
      "type": "table",
      "title": "IRIG Timing and SCB Status",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "IRIG Lock (0=OK)",   "points": "RM:acc{ant}:RM_IRIG_LOCK_ERROR_B",       "display_min": 0, "display_max": 3},
        {"label": "IRIG Err Count",     "points": "RM:acc{ant}:RM_IRIG_ERROR_COUNT_L",       "display_min": 0, "display_max": 1000000},
        {"label": "SCB Shutdown Req",   "points": "RM:acc{ant}:RM_SCB_SHUTDOWN_REQUEST_B"},
        {"label": "Bypass Prelims",     "points": "RM:acc{ant}:RM_SCB_BYPASS_PRELIMS_S"},
        {"label": "Bypass SoftLims",    "points": "RM:acc{ant}:RM_SCB_BYPASS_SOFTLIMS_S"},
        {"label": "Stow Request",       "points": "RM:acc{ant}:RM_SCB_STOW_REQUEST_B"},
        {"label": "Az Accel (deg/s2)",  "points": "RM:acc{ant}:RM_AZ_AMAX_F",               "format": "{:d}", "display_min": 0, "display_max": 99},
        {"label": "Pad ID",             "points": "RM:acc{ant}:RM_PAD_ID_B",                 "display_min": 1,   "display_max": 30},
        {"label": "Pad ID fake",        "points": "RM:acc{ant}:RM_PAD_ID_IS_FAKE_B", "format":"{!s}"},
        {"label": "Drives timeout",     "points": "RM:acc{ant}:RM_DRIVES_TIMEOUT_FLAG_S"}
      ]
    },
    {
      "type": "cells",
      "title": "Drive Fault State",
      "cells": [
        {"label": "DSM ESTOP (unavailable)", "point": "DSM:acc{ant}:DSM_ESTOP_COMMAND_S"}
      ]
    }
  ]
}
