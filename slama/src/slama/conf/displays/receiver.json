{
  "name": "Receiver Monitor",
  "description": "Receiver IF/LO chain: Gunn lock/power, PLL, continuity detector power, Tsys (from receiverMonitor.c)",
  "update_interval": 5,
  "layout": [
    {
      "type": "table",
      "title": "Low Receiver (RxA)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Active Low Rx",      "points": "RM:acc{ant}:RM_ACTIVE_LOW_RECEIVER_C10"},
        {"label": "Mixer board present","points": "RM:acc{ant}:RM_MIXER_BOARD_PRESENT_S"},
        {"label": "Gunn1 locked",       "points": "RM:acc{ant}:RM_GUNN1_LOCKED_S"},
        {"label": "Gunn1 achv power (dBm)", "points": "RM:acc{ant}:RM_GUNN1_ACHIEVED_RFPOWER_DBM_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Gunn1 req power (dBm)",  "points": "RM:acc{ant}:RM_GUNN1_REQUESTED_RFPOWER_DBM_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Gunn bias (V)",      "points": "RM:acc{ant}:RM_GUNN_BIAS_F",              "format": "{:.3f}", "display_min": -100, "display_max": 100},
        {"label": "PLL1 gain",          "points": "RM:acc{ant}:RM_PLL1_GAIN_S"},
        {"label": "Cont1 Det1 (mV)",    "points": "RM:acc{ant}:RM_CONT1_DET1_F",             "format": "{:.1f}", "display_min": -32768, "display_max": 32767},
        {"label": "Cont1 pwr (uW)",     "points": "RM:acc{ant}:RM_CONT1_DET1_POWER_MUWATT_F", "format": "{:.3f}", "display_min": 0, "display_max": 1e6},
        {"label": "Tsys (K)",           "points": "RM:acc{ant}:RM_TSYS_D",  "format": "{:.1f}", "display_min": 0, "display_max": 10000}
      ]
    },
    {
      "type": "table",
      "title": "High Receiver (RxB)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Active High Rx",     "points": "RM:acc{ant}:RM_ACTIVE_HIGH_RECEIVER_C10"},
        {"label": "Optics board present","points": "RM:acc{ant}:RM_OPTICS_BOARD_PRESENT_S"},
        {"label": "Gunn2 locked",       "points": "RM:acc{ant}:RM_GUNN2_LOCKED_S"},
        {"label": "Gunn2 on",           "points": "RM:acc{ant}:RM_GUNN2_ON_S"},
        {"label": "Gunn2 achv power (dBm)", "points": "RM:acc{ant}:RM_GUNN2_ACHIEVED_RFPOWER_DBM_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Gunn2 req power (dBm)",  "points": "RM:acc{ant}:RM_GUNN2_REQUESTED_RFPOWER_DBM_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Gunn2 bias (V)",     "points": "RM:acc{ant}:RM_GUNN2_BIAS_F",             "format": "{:.3f}", "display_min": -100, "display_max": 100},
        {"label": "PLL2 gain",          "points": "RM:acc{ant}:RM_PLL2_GAIN_S"},
        {"label": "Cont2 Det1 (mV)",    "points": "RM:acc{ant}:RM_CONT2_DET1_F",             "format": "{:.1f}", "display_min": -32768, "display_max": 32767},
        {"label": "Cont2 pwr (uW)",     "points": "RM:acc{ant}:RM_CONT2_DET1_MUWATT_F",      "format": "{:.3f}", "display_min": 0, "display_max": 1e6},
        {"label": "Tsys2 (K)",          "points": "RM:acc{ant}:RM_TSYS2_D", "format": "{:.1f}", "display_min": 0, "display_max": 10000}
      ]
    }
  ]
}
