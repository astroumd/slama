{
  "name": "Weather (Multi-Site)",
  "description": "Weather at summit sites: SMAroof, JCMT, Subaru, UKIRT, CFHT, UH88, IRTF — DSM placeholders",
  "update_interval": 30,
  "layout": [
    {
      "type": "grid",
      "title": "SMA Roof Weather (RM — live)",
      "columns": 3,
      "cells": [
        {"label": "T(amb) (F)",     "point": "RM:acc1:RM_WEATHER_TEMP_F",      "format": "{:.1f}", "display_min": -50,  "display_max": 150},
        {"label": "RH%",            "point": "RM:acc1:RM_WEATHER_HUMIDITY_F",  "format": "{:.1f}", "display_min": 0,    "display_max": 100},
        {"label": "Wind (mph)",     "point": "RM:acc1:RM_WEATHER_WINDSPEED_F", "format": "{:.1f}", "display_min": 0,    "display_max": 200},
        {"label": "Wind dir (deg)", "point": "RM:acc1:RM_WEATHER_WINDDIR_F",   "format": "{:.1f}", "display_min": 0,    "display_max": 360},
        {"label": "P(atm) (mbar)",  "point": "RM:acc1:RM_WEATHER_MBAR_F",     "format": "{:.1f}", "display_min": 400,  "display_max": 900}
      ]
    },
    {
      "type": "cells",
      "title": "Multi-Site Weather (DSM — placeholders)",
      "cells": [
        {"label": "JCMT Temp (C) (DSM)",      "point": "DSM:colossus:JCMT_METEOROLOGY_X:TEMP_F"},
        {"label": "JCMT Humidity % (DSM)",    "point": "DSM:colossus:JCMT_METEOROLOGY_X:HUMIDITY_F"},
        {"label": "JCMT Wind (mph) (DSM)",    "point": "DSM:colossus:JCMT_METEOROLOGY_X:WINDSPEED_F"},
        {"label": "Subaru Temp (C) (DSM)",    "point": "DSM:colossus:SUBARU_METEOROLOGY_X:TEMP_F"},
        {"label": "Subaru Humidity % (DSM)",  "point": "DSM:colossus:SUBARU_METEOROLOGY_X:HUMIDITY_F"},
        {"label": "UKIRT Temp (C) (DSM)",     "point": "DSM:colossus:UKIRT_METEOROLOGY_X:TEMP_F"},
        {"label": "Tau225 GFS (DSM)",         "point": "weather:forecast:gfs:tau225"},
        {"label": "Tau350 (DSM)",             "point": "DSM:colossus:DSM_CSO_350MICRON_TAU_SCALED_F"}
      ]
    },
    {
      "type": "table",
      "title": "Per-Antenna Skydip Age and Tau (DSM — placeholders)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Skydip age (DSM)",    "points": "dsm:placeholder:DSM_ANT{ant}_SKYDIP_AGE"},
        {"label": "Tau at freq (DSM)",   "points": "dsm:placeholder:DSM_ANT{ant}_TAU_FREQ"},
        {"label": "Tau225 (DSM)",        "points": "dsm:placeholder:DSM_ANT{ant}_TAU225"}
      ]
    }
  ]
}
