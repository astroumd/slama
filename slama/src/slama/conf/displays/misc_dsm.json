{
  "name": "Misc DSM (deice, genset, network, c1DC)",
  "description": "Deicing, network, C1DC (live RM, from deicemon.c/networkPage.c/c1DC.c); generator, YIG, SMA init (DSM placeholders)",
  "update_interval": 30,
  "layout": [
    {
      "type": "table",
      "title": "Deicing System (from deicemon.c)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Power cmd [5]",      "points": "RM:acc{ant}:RM_DEICE_POWER_CMD_V5_S"},
        {"label": "Current [3] (A)",    "points": "RM:acc{ant}:RM_DEICE_CURRENT_V3_F"},
        {"label": "Status bits",        "points": "RM:acc{ant}:RM_DEICE_STATUS_BITS_L"},
        {"label": "Phase",              "points": "RM:acc{ant}:RM_DEICE_PHASE_L"},
        {"label": "Chopper temp (C)",   "points": "RM:acc{ant}:RM_CHOPPER_TEMPERATURE_F", "format": "{:.1f}", "display_min": -100, "display_max": 300}
      ]
    },
    {
      "type": "cells",
      "title": "Deicing — Antenna 5 Structural Temps (DSM — placeholder)",
      "cells": [
        {"label": "Ant5 structural temps (DSM)", "point": "dsm:placeholder:DSM_ANTENNA5_TEMPS_X"}
      ]
    },
    {
      "type": "cells",
      "title": "Generator Set (DSM — placeholders)",
      "cells": [
        {"label": "Genset power (W) (DSM)",  "point": "dsm:placeholder:DSM_GENSET_POWER_W"},
        {"label": "Genset status (DSM)",     "point": "dsm:placeholder:DSM_GENSET_STATUS"}
      ]
    },
    {
      "type": "table",
      "title": "Receiver Network Status (from networkPage.c)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "RX microctrl network [15]", "points": "RM:acc{ant}:RM_RX_MICROCONTROLLER_NETWORK_V15_S"},
        {"label": "RX microctrl subtype [15]", "points": "RM:acc{ant}:RM_RX_MICROCONTROLLER_SUBTYPE_V15_S"},
        {"label": "Mixer board EPROM ver",     "points": "RM:acc{ant}:RM_MIXER_BOARD_EPROM_VERSION_S"},
        {"label": "Mixer board SRAM ver",      "points": "RM:acc{ant}:RM_MIXER_BOARD_SRAM_VERSION_S"},
        {"label": "Slave PLL no",              "points": "RM:acc{ant}:RM_SLAVE_PLL_NO_S"}
      ]
    },
    {
      "type": "table",
      "title": "C1DC Correlator (from c1DC.c)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Optics board present", "points": "RM:acc{ant}:RM_OPTICS_BOARD_PRESENT_S"},
        {"label": "Cal wheel status",     "points": "RM:acc{ant}:RM_CALIBRATION_WHEEL_S"},
        {"label": "Cal wheel timestamp",  "points": "RM:acc{ant}:RM_CALIBRATION_WHEEL_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000}
      ]
    },
    {
      "type": "cells",
      "title": "C1DC Correlator Power (DSM — placeholders)",
      "cells": [
        {"label": "C1DC power level (DSM)",  "point": "dsm:placeholder:DSM_C1DC_POWER_LEVEL"},
        {"label": "C1DC status (DSM)",       "point": "dsm:placeholder:DSM_C1DC_STATUS"}
      ]
    },
    {
      "type": "cells",
      "title": "YIG Frequencies (DSM — placeholders)",
      "cells": [
        {"label": "YIG freq (GHz) (DSM)",    "point": "dsm:placeholder:DSM_YIG_FREQ_GHZ"},
        {"label": "YIG lock status (DSM)",   "point": "dsm:placeholder:DSM_YIG_LOCK_STATUS"},
        {"label": "YIG tune word (DSM)",     "point": "dsm:placeholder:DSM_YIG_TUNE_WORD"}
      ]
    },
    {
      "type": "cells",
      "title": "SMA Initialization (DSM — placeholders)",
      "cells": [
        {"label": "Init state (DSM)",        "point": "dsm:placeholder:DSM_SMAINIT_STATE"},
        {"label": "Init progress (DSM)",     "point": "dsm:placeholder:DSM_SMAINIT_PROGRESS"}
      ]
    }
  ]
}
