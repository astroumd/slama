        {"label": "Genset power (W) (DSM)",  "point": "dsm:placeholder:DSM_GENSET_POWER_W"},
        {"label": "Genset status (DSM)",     "point": "dsm:placeholder:DSM_GENSET_STATUS"}
      ]
    },
    {
      "type": "cells",
      "title": "Network Interfaces (DSM — placeholders)",
      "cells": [
        {"label": "IP status (DSM)",         "point": "dsm:placeholder:DSM_NETWORK_IP_STATUS"},
        {"label": "Bandwidth (DSM)",         "point": "dsm:placeholder:DSM_NETWORK_BANDWIDTH"},
