        {"label": "Deice state (DSM)",       "point": "dsm:placeholder:DSM_DEICE_STATE"},
        {"label": "Deice temp (C) (DSM)",    "point": "dsm:placeholder:DSM_DEICE_TEMP_C"},
        {"label": "Deice status bits (DSM)", "point": "dsm:placeholder:DSM_DEICE_STATUS_BITS"}
