{
  "name": "Array Monitor",
  "description": "Overall array status: project, weather, source, receiver",
  "update_interval": 5,
  "layout": [
    {
      "type": "cells",
      "title": "Project / Observation",
      "cells": [
        {"label": "Project ID",    "point": "DSM:hal9000:DSM_AS_PROJECT_ID_L", "format":"{:%10d}"},
        {"label": "Observer",      "point": "DSM:hal9000:DSM_AS_PROJECT_OBSERVER_C30"},
        {"label": "Location",      "point": "DSM:hal9000:DSM_AS_PROJECT_OPERATINGLOCATION_C256"},
        {"label": "Scans remaining",  "point": "DSM:hal9000:DSM_AS_SCANS_REMAINING_L",  "format":"{:%5d}"},
        {"label": "Tau225",        "point": "DSM:colossus:DSM_CSO_225GHZ_TAU_F"},
        {"label": "Tau350",        "point": "DSM:colossus:DSM_CSO_350MICRON_TAU_SCALED_F"}
      ]
    },
    {
      "type": "cells",
      "title": "Current Source",
      "cells": [
        {"label": "Source",         "point": "RM:acc1:RM_SOURCE_C34"},
        {"label": "RA (hr)",        "point": "RM:acc1:RM_RA_CAT_HOURS_D",  "format": "{:.4f}", "display_min": 0,    "display_max": 24},
        {"label": "Dec (deg)",      "point": "RM:acc1:RM_DEC_CAT_DEG_D",   "format": "{:.4f}", "display_min": -90,  "display_max": 90},
        {"label": "LST (hr)",       "point": "RM:acc1:RM_LST_HOURS_F",     "format": "{:.4f}", "display_min": 0,    "display_max": 24},
        {"label": "Sun Az (deg)",   "point": "RM:acc1:RM_SUN_AZ_DEG_F",   "format": "{:.1f}", "display_min": 0,    "display_max": 360},
        {"label": "Sun El (deg)",   "point": "RM:acc1:RM_SUN_EL_DEG_F",   "format": "{:.1f}", "display_min": -90,  "display_max": 90}
      ]
    },
    {
      "type": "table",
      "title": "Antenna Positions",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Az (deg)", "points": "RM:acc{ant}:RM_ACTUAL_AZ_DEG_F", "format": "{:.2f}", "display_min": -360, "display_max": 360},
        {"label": "El (deg)", "points": "RM:acc{ant}:RM_ACTUAL_EL_DEG_F", "format": "{:.2f}", "display_min": -5,   "display_max": 90},
        {"label": "Low Rx",   "points": "RM:acc{ant}:RM_ACTIVE_LOW_RECEIVER_C10"},
        {"label": "High Rx",  "points": "RM:acc{ant}:RM_ACTIVE_HIGH_RECEIVER_C10"},
        {"label": "Tsys (K)", "points": "RM:acc{ant}:RM_TSYS_D", "format": "{:.1f}", "display_min": 0, "display_max": 10000}
      ]
    },
    {
      "type": "table",
      "title": "Safety / Operational Status",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Smoke warning",      "points": "RM:acc{ant}:RM_ANTENNA_SMOKE_WARNING_B"},
        {"label": "Antenna status",     "points": "RM:acc{ant}:RM_ANTENNA_STATUS_S"},
        {"label": "Tracking error (asec)", "points": "RM:acc{ant}:RM_TRACKING_ERROR_ARCSEC_F", "format": "{:.2f}", "display_min": 0, "display_max": 3600},
        {"label": "Encoder Az (deg)",   "points": "RM:acc{ant}:RM_ENCODER_AZ_F", "format": "{:.3f}", "display_min": -360, "display_max": 360},
        {"label": "Encoder El (deg)",   "points": "RM:acc{ant}:RM_ENCODER_EL_F", "format": "{:.3f}", "display_min": -5, "display_max": 90},
        {"label": "Az1 motor current",  "points": "RM:acc{ant}:RM_AZ1_MOT_CUR_AMP_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Az2 motor current",  "points": "RM:acc{ant}:RM_AZ2_MOT_CUR_AMP_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "El motor current",   "points": "RM:acc{ant}:RM_EL_MOT_CUR_AMP_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "M3 state",           "points": "RM:acc{ant}:RM_M3STATE_B"},
        {"label": "IRIG lock error",    "points": "RM:acc{ant}:RM_IRIG_LOCK_ERROR_B"}
      ]
    },
    {
      "type": "table",
      "title": "Drive Status Detail",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Pad ID",              "points": "RM:acc{ant}:RM_PAD_ID_B", "display_min": 1, "display_max": 30},
        {"label": "Antenna drive status","points": "RM:acc{ant}:RM_ANTENNA_DRIVE_STATUS_B"},
        {"label": "El drive state",      "points": "RM:acc{ant}:RM_EL_DRV_STATE_B"},
        {"label": "Servo fault state",   "points": "RM:acc{ant}:RM_SERVO_FAULT_STATE_B"},
        {"label": "Servo timestamp",     "points": "RM:acc{ant}:RM_SERVO_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "SCB fault word",      "points": "RM:acc{ant}:RM_SCB_FAULTWORD_L"},
        {"label": "SCB CCW limit",       "points": "RM:acc{ant}:RM_SCB_CCW_LIMIT_F", "format": "{:.2f}", "display_min": -360, "display_max": 360},
        {"label": "SCB CW limit",        "points": "RM:acc{ant}:RM_SCB_CW_LIMIT_F", "format": "{:.2f}", "display_min": -360, "display_max": 360},
        {"label": "SCB low limit",       "points": "RM:acc{ant}:RM_SCB_LOW_LIMIT_F", "format": "{:.2f}", "display_min": -90, "display_max": 90},
        {"label": "SCB up limit",        "points": "RM:acc{ant}:RM_SCB_UP_LIMIT_F", "format": "{:.2f}", "display_min": -90, "display_max": 90},
        {"label": "Commanded Az (deg)",  "points": "RM:acc{ant}:RM_COMMANDED_AZ_DEG_F", "format": "{:.3f}", "display_min": 0, "display_max": 360},
        {"label": "Commanded El (deg)",  "points": "RM:acc{ant}:RM_COMMANDED_EL_DEG_F", "format": "{:.3f}", "display_min": -90, "display_max": 90},
        {"label": "Tilt correction flag","points": "RM:acc{ant}:RM_TILT_CORRECTION_FLAG_L"},
        {"label": "Unheated load status","points": "RM:acc{ant}:RM_UNHEATEDLOAD_STATUS_S"}
      ]
    },
    {
      "type": "table",
      "title": "Receiver / Optics Detail",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Gunn1 locked",        "points": "RM:acc{ant}:RM_GUNN1_LOCKED_S"},
        {"label": "Gunn1 locked time",   "points": "RM:acc{ant}:RM_GUNN1_LOCKED_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Gunn2 locked",        "points": "RM:acc{ant}:RM_GUNN2_LOCKED_S"},
        {"label": "YIG1 locked",         "points": "RM:acc{ant}:RM_YIG1_LOCKED_S"},
        {"label": "YIG2 locked",         "points": "RM:acc{ant}:RM_YIG2_LOCKED_S"},
        {"label": "YIG switch high freq","points": "RM:acc{ant}:RM_YIG_SWITCH_HIGH_FREQ_S"},
        {"label": "Optics board present","points": "RM:acc{ant}:RM_OPTICS_BOARD_PRESENT_S"},
        {"label": "Cal wheel status",    "points": "RM:acc{ant}:RM_CALIBRATION_WHEEL_S"},
        {"label": "Cal wheel timestamp", "points": "RM:acc{ant}:RM_CALIBRATION_WHEEL_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Tune6 command busy",  "points": "RM:acc{ant}:RM_TUNE6_COMMAND_BUSY_S"},
        {"label": "Waveplate rotation",  "points": "RM:acc{ant}:RM_WAVEPLATE_ROTATION_STATUS_S"},
        {"label": "Refraction radio flag","points": "RM:acc{ant}:RM_REFRACTION_RADIO_FLAG_B"},
        {"label": "SyncDet2 timestamp",  "points": "RM:acc{ant}:RM_SYNCDET2_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Tsys2 (K)",           "points": "RM:acc{ant}:RM_TSYS2_D", "format": "{:.1f}", "display_min": 0, "display_max": 10000},
        {"label": "Tsys timestamp",      "points": "RM:acc{ant}:RM_TSYS_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Track timestamp",     "points": "RM:acc{ant}:RM_TRACK_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "UTC (hr)",            "points": "RM:acc{ant}:RM_UTC_HR_D", "format": "{:.4f}", "display_min": 0, "display_max": 24}
      ]
    },
    {
      "type": "table",
      "title": "Pointing / Deice / Dewar Detail",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Az offset",           "points": "RM:acc{ant}:RM_RAOFF_ARCSEC_D", "format": "{:.2f}", "display_min": -3600, "display_max": 3600},
        {"label": "Dec offset",          "points": "RM:acc{ant}:RM_DECOFF_ARCSEC_D", "format": "{:.2f}", "display_min": -3600, "display_max": 3600},
        {"label": "Sun-safe now (min)",  "points": "RM:acc{ant}:RM_PRESENT_SUN_SAFE_MINUTES_S", "display_min": -1, "display_max": 10000},
        {"label": "Sun-safe req (min)",  "points": "RM:acc{ant}:RM_REQUIERD_SUN_SAFE_MINUTES_S", "display_min": -1, "display_max": 10000},
        {"label": "Deice status bits",   "points": "RM:acc{ant}:RM_DEICE_STATUS_BITS_L"},
        {"label": "Deice timestamp",     "points": "RM:acc{ant}:RM_DEICE_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Dewar temps [16] (K)","points": "RM:acc{ant}:RM_DEWAR_TEMPS_V16_F"},
        {"label": "Lakeshore timestamp", "points": "RM:acc{ant}:RM_LAKESHORE_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Chopper monitor time","points": "RM:acc{ant}:RM_CHOPPER_MONITOR_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Chopper status bits [16]", "points": "RM:acc{ant}:RM_CHOPPER_STATUS_BITS_V16_B"}
      ]
    },
    {
      "type": "cells",
      "title": "Ephemeris / Polar Motion",
      "cells": [
        {"label": "RA apparent (hr)",      "point": "RM:acc1:RM_RA_APP_HR_D",  "format": "{:.4f}", "display_min": 0, "display_max": 24},
        {"label": "Dec apparent (deg)",    "point": "RM:acc1:RM_DEC_APP_DEG_D", "format": "{:.4f}", "display_min": -90, "display_max": 90},
        {"label": "Epoch",                 "point": "RM:acc1:RM_EPOCH_F", "format": "{:.1f}", "display_min": 1900, "display_max": 2100},
        {"label": "Refraction (asec)",     "point": "RM:acc1:RM_REFRACTION_ARCSEC_D", "format": "{:.2f}", "display_min": 0, "display_max": 3600},
        {"label": "Source velocity (km/s)","point": "RM:acc1:RM_SVEL_KMPS_D", "format": "{:.2f}", "display_min": -1000, "display_max": 1000},
        {"label": "TJD",                   "point": "RM:acc1:RM_TJD_D", "format": "{:.2f}", "display_min": 0, "display_max": 100000000},
        {"label": "UTC (hr)",              "point": "RM:acc1:RM_UTC_HOURS_F", "format": "{:.4f}", "display_min": 0, "display_max": 24},
        {"label": "Planet diameter (asec)","point": "RM:acc1:RM_PLANET_DIAMETER_ARCSEC_D", "format": "{:.3f}", "display_min": 0, "display_max": 3600},
        {"label": "Planet distance (AU)",  "point": "RM:acc1:RM_PLANET_DISTANCE_AU_D", "format": "{:.4f}", "display_min": 0, "display_max": 100},
        {"label": "Polar DUT (s)",         "point": "RM:acc1:RM_POLAR_DUT_SEC_D", "format": "{:.4f}", "display_min": -2, "display_max": 2},
        {"label": "Polar Dx (asec)",       "point": "RM:acc1:RM_POLAR_DX_ARCSEC_D", "format": "{:.4f}", "display_min": -2, "display_max": 2},
        {"label": "Polar Dy (asec)",       "point": "RM:acc1:RM_POLAR_DY_ARCSEC_D", "format": "{:.4f}", "display_min": -2, "display_max": 2},
        {"label": "Polar MJD",             "point": "RM:acc1:RM_POLAR_MJD_L", "format": "{:.4f}", "display_min": 0, "display_max": 1000000},
        {"label": "Aux weather timestamp", "point": "RM:acc6:RM_GETWEATHER_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000}
      ]
    },
    {
      "type": "grid",
      "title": "Weather",
      "columns": 3,
      "cells": [

        {"label": "T(amb) (C)",     "point": "RM:acc1:RM_WEATHER_TEMP_F",      "format": "{:.1f}", "display_min": -50,  "display_max": 150},
        {"label": "RH%",            "point": "RM:acc1:RM_WEATHER_HUMIDITY_F",  "format": "{:.1f}", "display_min": 0,    "display_max": 100},
        {"label": "P(atm) (mbar)",  "point": "RM:acc1:RM_WEATHER_MBAR_F",     "format": "{:.1f}", "display_min": 100,  "display_max": 1900},
        {"label": "Wind Server",     "point": "DSM:colossus:DSM_WIND_SERVER_C7"},
        {"label": "Wind (m/s)",     "point": "DSM:colossus:SMA_METEOROLOGY_X:WINDSPEED_F", "format": "{:.1f}", "display_min": 0,    "display_max": 200},
        {"label": "Wind dir (deg)", "point": "DSM:colossus:SMA_METEOROLOGY_X:WINDDIR_F",   "format": "{:.1f}", "display_min": 0,    "display_max": 360}
      ]
    }
  ]
}
