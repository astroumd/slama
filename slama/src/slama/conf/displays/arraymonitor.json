{
  "name": "Array Monitor",
  "description": "Overall array status: project, weather, source, receiver",
  "update_interval": 5,
  "layout": [
    {
      "type": "cells",
      "title": "Project / Observation",
      "cells": [
        {"label": "Project ID",    "point": "DSM:hal9000:DSM_AS_PROJECT_ID_L", "format":"{:d}", "display_min":0, "display_max":100000},
        {"label": "Observer",      "point": "DSM:hal9000:DSM_AS_PROJECT_OBSERVER_C30"},
        {"label": "Location",      "point": "DSM:hal9000:DSM_AS_PROJECT_OPERATINGLOCATION_C256"},
        {"label": "Scans remaining",  "point": "DSM:hal9000:DSM_AS_SCANS_REMAINING_L",  "format":"{:d}", "display_min":0, "display_max":1000}
      ]
    },
    {
      "type": "cells",
      "title": "Current Source",
      "cells": [
        {"label": "Source",         "point": "RM:acc1:RM_SOURCE_C34"},
        {"label": "RA (hr)",        "point": "RM:acc1:RM_RA_CAT_HOURS_D",  "format": "{:.4f}", "display_min": 0,    "display_max": 24},
        {"label": "Dec (deg)",      "point": "RM:acc1:RM_DEC_CAT_DEG_D",   "format": "{:.4f}", "display_min": -90,  "display_max": 90},
        {"label": "LST (hr)",       "point": "RM:acc1:RM_LST_HOURS_F",     "format": "{:.4f}", "display_min": 0,    "display_max": 24},
        {"label": "Sun Az (deg)",   "point": "RM:acc1:RM_SUN_AZ_DEG_F",   "format": "{:.1f}", "display_min": 0,    "display_max": 360},
        {"label": "Sun El (deg)",   "point": "RM:acc1:RM_SUN_EL_DEG_F",   "format": "{:.1f}", "display_min": -90,  "display_max": 90}
      ]
    },
    {
      "type": "table",
      "title": "Antenna Positions",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Az (deg)", "points": "RM:acc{ant}:RM_ACTUAL_AZ_DEG_F", "format": "{:.2f}", "display_min": -360, "display_max": 360},
        {"label": "El (deg)", "points": "RM:acc{ant}:RM_ACTUAL_EL_DEG_F", "format": "{:.2f}", "display_min": -5,   "display_max": 90},
        {"label": "Tsys (K)", "points": "RM:acc{ant}:RM_TSYS_D", "format": "{:.1f}", "display_min": 0, "display_max": 10000}
      ]
    },
    {
      "type": "table",
      "title": "Antenna Status (computed)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Drive status",        "points": "monitorsystem:antenna:{ant}:drive_status"},
        {"label": "On source",           "points": "monitorsystem:antenna:{ant}:on_source"},
        {"label": "Track age (s)",       "points": "monitorsystem:antenna:{ant}:track_age", "format": "{:.0f}"},
        {"label": "Servo age (s)",       "points": "monitorsystem:antenna:{ant}:servo_age", "format": "{:.0f}"},
        {"label": "Sun distance (deg)",  "points": "monitorsystem:antenna:{ant}:sun_distance", "format": "{:.1f}"},
        {"label": "Hour angle (h)",      "points": "monitorsystem:antenna:{ant}:hour_angle", "format": "{:+.3f}"},
        {"label": "Chopper",             "points": "monitorsystem:antenna:{ant}:chopper_status"},
        {"label": "Deice",               "points": "monitorsystem:antenna:{ant}:deice_status"},
        {"label": "Clock offset (s)",    "points": "monitorsystem:antenna:{ant}:clock_offset_s", "format": "{:+.2f}"},
        {"label": "Rx low",              "points": "monitorsystem:antenna:{ant}:rx_low_label"},
        {"label": "Rx high",             "points": "monitorsystem:antenna:{ant}:rx_high_label"},
        {"label": "LO (g1-y1/g2-y2)",    "points": "monitorsystem:antenna:{ant}:lo_status"},
        {"label": "LO locked for band",  "points": "monitorsystem:antenna:{ant}:lo_lock_ok"},
        {"label": "YIG1 locked",         "points": "monitorsystem:antenna:{ant}:yig1_locked"},
        {"label": "YIG2 locked",         "points": "monitorsystem:antenna:{ant}:yig2_locked"},
        {"label": "Load",                "points": "monitorsystem:antenna:{ant}:hotload_position"},
        {"label": "Dewar 4K (K)",        "points": "monitorsystem:antenna:{ant}:dewar_4k_temp", "format": "{:.2f}"},
        {"label": "Online",              "points": "monitorsystem:antenna:{ant}:online"},
        {"label": "Scan flagged",        "points": "monitorsystem:antenna:{ant}:scan_flagged"},
        {"label": "Sun-safe (min)",      "points": "monitorsystem:antenna:{ant}:sun_safe_minutes"},
        {"label": "M3 door",             "points": "monitorsystem:antenna:{ant}:m3_state"},
        {"label": "M3 door open",        "points": "monitorsystem:antenna:{ant}:m3_door_open"},
        {"label": "Waveplate",           "points": "monitorsystem:antenna:{ant}:waveplate"},
        {"label": "Palm off",            "points": "monitorsystem:antenna:{ant}:palm_off"},
        {"label": "Motor",               "points": "monitorsystem:antenna:{ant}:motor_alarm"},
        {"label": "Az/El flag",          "points": "monitorsystem:antenna:{ant}:azel_flag"},
        {"label": "El drive fault",      "points": "monitorsystem:antenna:{ant}:el_drive_fault"}
      ]
    },
    {
      "type": "cells",
      "title": "Array (computed)",
      "cells": [
        {"label": "# Antennas online",        "point": "monitorsystem:array:antennas_online"},
        {"label": "# Antennas focus curve on", "point": "monitorsystem:array:focus_curve_count"},
        {"label": "Rx 1 (low) line",           "point": "monitorsystem:rx:1:line_name"},
        {"label": "Rx 2 (high) line",          "point": "monitorsystem:rx:2:line_name"},
        {"label": "Source type flags",  "point": "monitorsystem:array:source_type_flags"},
        {"label": "SWARM scan",         "point": "monitorsystem:array:swarm_scan_status"},
        {"label": "SWARM progress (s)", "point": "monitorsystem:array:swarm_progress_s", "format": "{:.1f}"},
        {"label": "SWARM length (s)",   "point": "monitorsystem:array:swarm_length_s", "format": "{:.1f}"},
        {"label": "Last scan age (s)",  "point": "monitorsystem:array:scan_age_s", "format": "{:.0f}"},
        {"label": "Pointing offset spread (\")", "point": "monitorsystem:array:pointing_offset_spread_arcsec", "format": "{:.3f}"},
        {"label": "Equipment room (C)",  "point": "monitorsystem:array:equipment_room_temp", "format": "{:.1f}"}
      ]
    },
    {
      "type": "table",
      "title": "Safety / Operational Status",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Smoke alarm",        "points": "monitorsystem:antenna:{ant}:smoke_alarm"}
      ]
    },
    {
      "type": "table",
      "title": "Drive Status Detail",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Pad ID",              "points": "RM:acc{ant}:RM_PAD_ID_B", "display_min": 1, "display_max": 30},
        {"label": "Commanded Az (deg)",  "points": "RM:acc{ant}:RM_COMMANDED_AZ_DEG_F", "format": "{:.3f}", "display_min": 0, "display_max": 360},
        {"label": "Commanded El (deg)",  "points": "RM:acc{ant}:RM_COMMANDED_EL_DEG_F", "format": "{:.3f}", "display_min": -90, "display_max": 90},
        {"label": "Tilt flag vs default","points": "monitorsystem:antenna:{ant}:tilt_flag"}
      ]
    },
    {
      "type": "table",
      "title": "Receiver / Optics Detail",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "SyncDet2 timestamp",  "points": "RM:acc{ant}:RM_SYNCDET2_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Tsys2 (K)",           "points": "RM:acc{ant}:RM_TSYS2_D", "format": "{:.1f}", "display_min": 0, "display_max": 10000},
        {"label": "Tsys timestamp",      "points": "RM:acc{ant}:RM_TSYS_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000}
      ]
    },
    {
      "type": "table",
      "title": "Pointing / Deice / Dewar Detail",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Az offset",           "points": "RM:acc{ant}:RM_RAOFF_ARCSEC_D", "format": "{:.2f}", "display_min": -3600, "display_max": 3600},
        {"label": "Dec offset",          "points": "RM:acc{ant}:RM_DECOFF_ARCSEC_D", "format": "{:.2f}", "display_min": -3600, "display_max": 3600}
      ]
    },
    {
      "type": "cells",
      "title": "Ephemeris / Polar Motion",
      "cells": [
        {"label": "Epoch",                 "point": "RM:acc1:RM_EPOCH_F", "format": "{:.1f}", "display_min": 1900, "display_max": 2100},
        {"label": "Source velocity (km/s)","point": "RM:acc1:RM_SVEL_KMPS_D", "format": "{:.2f}", "display_min": -1000, "display_max": 1000},
        {"label": "TJD",                   "point": "RM:acc1:RM_TJD_D", "format": "{:.2f}", "display_min": 0, "display_max": 100000000},
        {"label": "UTC (hr)",              "point": "RM:acc1:RM_UTC_HOURS_F", "format": "{:.4f}", "display_min": 0, "display_max": 24},
        {"label": "Planet diameter (asec)","point": "RM:acc1:RM_PLANET_DIAMETER_ARCSEC_D", "format": "{:.3f}", "display_min": 0, "display_max": 3600},
        {"label": "Planet distance (AU)",  "point": "RM:acc1:RM_PLANET_DISTANCE_AU_D", "format": "{:.4f}", "display_min": 0, "display_max": 100},
        {"label": "Polar DUT (s)",         "point": "RM:acc1:RM_POLAR_DUT_SEC_D", "format": "{:.4f}", "display_min": -2, "display_max": 2},
        {"label": "Polar MJD",             "point": "RM:acc1:RM_POLAR_MJD_L", "format": "{:.4f}", "display_min": 0, "display_max": 1000000}
      ]
    },
    {
      "type": "grid",
      "title": "Weather",
      "columns": 3,
      "cells": [

        {"label": "T(amb) (C)",     "point": "RM:acc1:RM_WEATHER_TEMP_F",      "format": "{:.1f}", "display_min": -50,  "display_max": 150},
        {"label": "RH%",            "point": "RM:acc1:RM_WEATHER_HUMIDITY_F",  "format": "{:.1f}", "display_min": 0,    "display_max": 100},
        {"label": "P(atm) (mbar)",  "point": "RM:acc1:RM_WEATHER_MBAR_F",     "format": "{:.1f}", "display_min": 100,  "display_max": 1900}
      ]
    },
    {
      "type": "grid",
      "title": "Weather (computed)",
      "columns": 3,
      "cells": [
        {"label": "Wind (m/s)",           "point": "monitorsystem:weather:wind_speed", "format": "{:.1f}"},
        {"label": "Wind dir (deg)",       "point": "monitorsystem:weather:wind_direction", "format": "{:.0f}"},
        {"label": "Wind source",          "point": "monitorsystem:weather:wind_source"},
        {"label": "Wind stations excluded", "point": "monitorsystem:weather:wind_invalid_stations"},
        {"label": "Weather servers",      "point": "monitorsystem:weather:server_label"},
        {"label": "Weather data age (s)", "point": "monitorsystem:weather:data_age_s", "format": "{:.0f}"},
        {"label": "Sun visible",          "point": "monitorsystem:weather:sun_visible"},
        {"label": "Tau225 (GFS)",           "point": "monitorsystem:weather:gfs_tau225", "format": "{:.3f}"},
        {"label": "Generator running",    "point": "monitorsystem:array:genset_active"}
      ]
    }
  ]
}
