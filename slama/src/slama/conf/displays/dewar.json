{
  "name": "Dewar / Cryostat",
  "description": "Dewar temperatures/pressure, cold head hours, glycol cooling (from dewarpage.c)",
  "update_interval": 10,
  "layout": [
    {
      "type": "table",
      "title": "Dewar / Cryostat",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Dewar temps [16]",        "points": "RM:acc{ant}:RM_DEWAR_TEMPS_V16_F"},
        {"label": "Dewar pressure",          "points": "RM:acc{ant}:RM_DEWAR_PRESSURE_F", "format": "{:.3e}", "display_min": 0, "display_max": 1},
        {"label": "Cold head running hrs",   "points": "RM:acc{ant}:RM_COLD_HEAD_RUNNING_HOURS_F", "format": "{:.1f}", "display_min": 0, "display_max": 1e6},
        {"label": "Cold head rebuild hrs",   "points": "RM:acc{ant}:RM_COLD_HEAD_REBUILD_HOURS_F", "format": "{:.1f}", "display_min": 0, "display_max": 1e6},
        {"label": "Glycol flow",             "points": "RM:acc{ant}:RM_GLYCOL_FLOW_D",     "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Glycol pressure",         "points": "RM:acc{ant}:RM_GLYCOL_PRESSURE_D", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Glycol temp",             "points": "RM:acc{ant}:RM_GLYCOL_TEMP_D",     "format": "{:.2f}", "display_min": -100, "display_max": 200},
        {"label": "Balzers timestamp",       "points": "RM:acc{ant}:RM_BALZERS_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Lakeshore timestamp",     "points": "RM:acc{ant}:RM_LAKESHORE_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000},
        {"label": "Cryo monitor email status","points": "RM:acc{ant}:RM_CRYO_MONITOR_EMAIL_STATUS_S"},
        {"label": "SCB fault word",          "points": "RM:acc{ant}:RM_SCB_FAULTWORD_L"}
      ]
    },
    {
      "type": "table",
      "title": "Turbopump",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Turbopump RPM",           "points": "RM:acc{ant}:RM_TURBOPUMP_RPM_F", "format": "{:.0f}", "display_min": 0, "display_max": 100000},
        {"label": "Turbopump threshold RPM", "points": "RM:acc{ant}:RM_TURBOPUMP_THRESHOLD_RPM_F", "format": "{:.0f}", "display_min": 0, "display_max": 100000},
        {"label": "Turbopump status",        "points": "RM:acc{ant}:RM_TURBOPUMP_STATUS_C20"},
        {"label": "Turbopump temp (F)",      "points": "RM:acc{ant}:RM_TURBOPUMP_TEMPERATURE_F", "format": "{:.1f}", "display_min": -50, "display_max": 200},
        {"label": "Turbopump voltage",       "points": "RM:acc{ant}:RM_TURBOPUMP_VOLTAGE_F", "format": "{:.2f}", "display_min": -100, "display_max": 100},
        {"label": "Turbopump timestamp",     "points": "RM:acc{ant}:RM_TURBOPUMP_TIMESTAMP_L", "display_min": 0, "display_max": 2000000000}
      ]
    }
  ]
}
