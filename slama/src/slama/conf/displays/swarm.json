{
  "name": "SWARM Correlator",
  "description": "ROACH2 board temperatures, delays, Walsh patterns, loading factors — DSM placeholders",
  "update_interval": 10,
  "layout": [
    {
      "type": "table",
      "title": "ROACH2 Board Temperatures (C) (DSM — placeholders)",
      "columns": {
        "labels": ["R2-01", "R2-02", "R2-03", "R2-04", "R2-05", "R2-06", "R2-07", "R2-08"],
        "var": "roach",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "Ambient (C) (DSM)",   "points": "DSM:obscon:ROACH2_{roach}_TEMPS_X:AMBIENT_TEMP_V8_F"},
        {"label": "Inlet (C) (DSM)",     "points": "DSM:obscon:ROACH2_{roach}_TEMPS_X:INLET_TEMP_V8_F"},
        {"label": "Outlet (C) (DSM)",    "points": "DSM:obscon:ROACH2_{roach}_TEMPS_X:OUTLET_TEMP_V8_F"},
        {"label": "PowerPC (C) (DSM)",   "points": "DSM:obscon:ROACH2_{roach}_TEMPS_X:PPC_TEMP_V8_F"},
        {"label": "FPGA (C) (DSM)",      "points": "DSM:obscon:ROACH2_{roach}_TEMPS_X:FPGA_TEMP_V8_F"},
        {"label": "Temp age (DSM)",      "points": "DSM:obscon:ROACH2_{roach}_TEMPS_X:TIMESTAMP_V8_L"}
      ]
    },
    {
      "type": "table",
      "title": "Delays and Walsh Patterns (DSM — placeholders)",
      "columns": {
        "labels": ["Ant 1", "Ant 2", "Ant 3", "Ant 4", "Ant 5", "Ant 6", "Ant 7", "Ant 8"],
        "var": "ant",
        "values": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      "rows": [
        {"label": "DDS Delay (ns) (DSM)",  "points": "DSM:newdds:DDS_TO_HAL_X:DEL_V11_D"},
        {"label": "FPGA Delay (ns) (DSM)", "points": "DSM:roach2-{ant}:SWARM_FSTOP_STATS_X:FSTOP_DELAY_V2_D"},
        {"label": "Sum Delay (ns) (DSM)",  "points": "DSM:roach2-{ant}:SWARM_FSTOP_STATS_X:FSTOP_DELAY_V2_D"},
        {"label": "Walsh pattern (DSM)",   "points": "DSM:newdds:DDS_TO_HAL_X:WALSH_MOD_V11_V2_S"},
        {"label": "LF load factor (DSM)",  "points": "DSM:roach2-{ant}:SWARM_LOADING_FACTOR_V2_F"},
        {"label": "HF load factor (DSM)",  "points": "DSM:roach2-{ant}:SWARM_LOADING_FACTOR_V2_F"}
      ]
    }
  ]
}
