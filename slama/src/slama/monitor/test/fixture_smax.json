{
  "subsystem_a": {
    "sensor1": {
      "description": "Temperature sensor",
      "size": "1",
      "smax_type": "float",
      "unit": "C"
    },
    "sensor2": {
      "description": "Pressure sensor",
      "size": "1",
      "smax_type": "int"
    },
    "nested": {
      "deep_value": {
        "description": "Deep voltage sensor",
        "size": "1",
        "smax_type": "float64",
        "unit": "V"
      }
    }
  },
  "subsystem_b": {
    "flag": {
      "description": "Status flag",
      "size": "1",
      "smax_type": "bool"
    }
  },
  "rm_test": {
    "__each__": {
      "over": "node1,node2,node3",
      "template": {
        "temperature": {
          "description": "Node temperature",
          "size": "1",
          "smax_type": "float",
          "unit": "C",
          "warn_low": 5.0,
          "warn_high": 40.0,
          "err_low": 0.0,
          "err_high": 50.0
        },
        "status": {
          "description": "Node status string",
          "size": "1",
          "smax_type": "string",
          "valid_strings": ["ok", "degraded"]
        }
      }
    }
  }
}
